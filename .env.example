# 이 파일을 .env.local 로 복사해서 값을 채우세요. .env.local 은 절대 커밋하지 않습니다.

# Supabase 프로젝트 설정 > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 (가져오기 웹훅, 푸시 발송). 브라우저에 노출 금지
SUPABASE_SERVICE_ROLE_KEY=

# AI 도우미 (Claude API). 비우면 AI 기능이 꺼진다
ANTHROPIC_API_KEY=
# 비용 계산용 환율 (원/달러). AI 한도 = 그달 남은 예산의 10%
AI_USD_KRW=1500

# 웹 푸시 VAPID 키: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=
